{
  "name": "myfiles",
  "version": "1.1.1",
  "description": "MyFiles - Fast, keyboard-first Windows File Manager with Quick Look, Miller Columns, and Colored Tags",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "server": "node server.js",
    "test": "node test/self-check.js",
    "build": "npx electron-builder --win nsis portable",
    "build:local": "npx electron-builder --win nsis portable --config.electronDist=node_modules/electron/dist --publish never",
    "build:installer": "npx electron-builder --win nsis --config.electronDist=node_modules/electron/dist --publish never",
    "build:portable": "npx electron-builder --win portable",
    "build:dir": "npx electron-builder --dir"
  },
  "keywords": [
    "file-manager",
    "windows-explorer",
    "finder",
    "quick-look",
    "miller-columns",
    "tags"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.4.5"
  },
  "build": {
    "appId": "com.andruia.myfiles",
    "productName": "MyFiles",
    "publish": {
      "provider": "github",
      "owner": "thesatyamjain",
      "repo": "myfiles"
    },
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "storage.js",
      "fs-engine.js",
      "archive.js",
      "vlc.js",
      "dedup.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/installerHeader.bmp",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyFiles",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
